{
  "expo": {
    "name": "scrabble_mobile",
    "slug": "scrabble_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scrabblemobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F5EDD6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.islainkouam.scrabble"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.islainkouam.scrabble"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router", "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
