{
  "expo": {
    "name": "Scrabble",
    "slug": "scrabble-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "scrabble",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.islain.scrabble"
    },
    "android": {
      "package": "com.islain.scrabble",
      "adaptiveIcon": {
        "backgroundColor": "#F5EDD6"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}